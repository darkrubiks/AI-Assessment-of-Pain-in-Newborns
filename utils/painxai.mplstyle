# =============================
#  PainXAI Matplotlib Style (10 Explainers)
#  Author: Leonardo Ferreira
#  =============================

# --- Figure layout ---
figure.figsize: 6.5, 4
figure.dpi: 300
figure.autolayout: True

# --- Fonts and text ---
font.family: sans-serif
font.sans-serif: DejaVu Sans, Helvetica, Arial
font.size: 11
axes.titlesize: 12
axes.labelsize: 11
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
text.color: 111111

# --- Axes ---
axes.linewidth: 0.8
axes.edgecolor: 333333
axes.labelcolor: 111111
axes.grid: True
axes.grid.which: both
axes.grid.axis: both
axes.spines.top: False
axes.spines.right: False
grid.color: cccccc
grid.alpha: 0.4
grid.linestyle: --

# --- Highly distinguishable PainXAI palette (color-blind safe) ---
axes.prop_cycle: cycler('color', ['4477AA','EE7733','228833','CC6677','AA3377','66CCEE','999933','EE3377','994F00','BBBBBB'])
# --- Lines and markers ---
lines.linewidth: 2
lines.markersize: 5
lines.markeredgewidth: 0.8

# --- Legend ---
legend.frameon: False
legend.loc: best

# --- Tick parameters ---
xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
xtick.color: 333333
ytick.color: 333333

# --- Savefig ---
savefig.dpi: 300
savefig.transparent: True
savefig.bbox: tight
